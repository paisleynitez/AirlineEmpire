grf {
    grfid: "HCA2";
    name: string(STR_GRF_NAME);
    desc: string(STR_GRF_DESC);
    version: 1;
    min_compatible_version: 1;
}

spriteset(sprite_tile_0_0, "gfx/airport_grand.png") { [224, 8, 64, 72, -31, -40] }
spritelayout layout_tile_0_0 {
    ground { sprite: 2634; }
    building { sprite: sprite_tile_0_0; xoffset: 0; yoffset: 0; zoffset: 0; xextent: 16; yextent: 16; zextent: 40; }
}
item(FEAT_AIRPORTTILES, tile_0_0) {
    property { substitute: 23; }
    graphics { default: layout_tile_0_0; }
}

