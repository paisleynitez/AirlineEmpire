tilelayout airport_layout {
    rotation: DIRECTION_NORTH;
    0, 0: tile_0_0;
    1, 0: 1;
    2, 0: 25;
    3, 0: 1;
    4, 0: 1;
    5, 0: 24;
    0, 1: tile_0_1;
    1, 1: 28;
    2, 1: tile_2_1;
    3, 1: 26;
    4, 1: 0;
    5, 1: 2;
    0, 2: tile_0_2;
    1, 2: 3;
    2, 2: 27;
    3, 2: 5;
    4, 2: 12;
    5, 2: 13;
    0, 3: tile_0_3;
    1, 3: 0;
    2, 3: 0;
    3, 3: 0;
    4, 3: 0;
    5, 3: tile_5_3;
    0, 4: 45;
    1, 4: 46;
    2, 4: 46;
    3, 4: 46;
    4, 4: 46;
    5, 4: 45;
    0, 5: 18;
    1, 5: 15;
    2, 5: 15;
    3, 5: 15;
    4, 5: 15;
    5, 5: 18;
}

item(FEAT_AIRPORTS, city_grand) {
    property {
        override: 3;
        name: string(STR_AIRPORT_NAME);
        layouts: [airport_layout];
        years_available: [1960, 65535];
        ttd_airport_type: AIRPORTTYPE_LARGE;
        catchment_area: 6;
        noise_level: 8;
        maintenance_cost: 28;
    }
    graphics { additional_text: string(STR_ADDITIONAL); }
}
