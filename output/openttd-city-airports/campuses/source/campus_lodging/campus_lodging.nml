template deptstore_tmpl_tile(n) { [8 + n * 72, 8, 64, 66, -31, -34] }

spriteset(deptstore_spr_back_a,  "gfx/deptstore.png") { deptstore_tmpl_tile(0) }
spriteset(deptstore_spr_back_b,  "gfx/deptstore.png") { deptstore_tmpl_tile(1) }
spriteset(deptstore_spr_front_a, "gfx/deptstore.png") { deptstore_tmpl_tile(2) }
spriteset(deptstore_spr_front_b, "gfx/deptstore.png") { deptstore_tmpl_tile(3) }

spritelayout deptstore_lay_back_a  { ground { sprite: 1420; } building { sprite: deptstore_spr_back_a;  xoffset: 0; yoffset: 0; zoffset: 0; xextent: 16; yextent: 16; zextent: 34; } }
spritelayout deptstore_lay_back_b  { ground { sprite: 1420; } building { sprite: deptstore_spr_back_b;  xoffset: 0; yoffset: 0; zoffset: 0; xextent: 16; yextent: 16; zextent: 34; } }
spritelayout deptstore_lay_front_a { ground { sprite: 1420; } building { sprite: deptstore_spr_front_a; xoffset: 0; yoffset: 0; zoffset: 0; xextent: 16; yextent: 16; zextent: 20; } }
spritelayout deptstore_lay_front_b { ground { sprite: 1420; } building { sprite: deptstore_spr_front_b; xoffset: 0; yoffset: 0; zoffset: 0; xextent: 16; yextent: 16; zextent: 20; } }

item(FEAT_INDUSTRYTILES, deptstore_tile_back_a)  { property { substitute: 0; accepted_cargos: [[PASS, 8], [GOOD, 4]]; } graphics { default: deptstore_lay_back_a; } }
item(FEAT_INDUSTRYTILES, deptstore_tile_back_b)  { property { substitute: 0; accepted_cargos: [[PASS, 8], [GOOD, 4]]; } graphics { default: deptstore_lay_back_b; } }
item(FEAT_INDUSTRYTILES, deptstore_tile_front_a) { property { substitute: 0; accepted_cargos: [[PASS, 8], [GOOD, 4]]; } graphics { default: deptstore_lay_front_a; } }
item(FEAT_INDUSTRYTILES, deptstore_tile_front_b) { property { substitute: 0; accepted_cargos: [[PASS, 8], [GOOD, 4]]; } graphics { default: deptstore_lay_front_b; } }

/* 2x2 */
tilelayout deptstore_main_layout {
    0, 0: deptstore_tile_back_a;
    1, 0: deptstore_tile_back_b;
    0, 1: deptstore_tile_front_a;
    1, 1: deptstore_tile_front_b;
}

/* Every visitor delivered goes home again later; other cargo is simply taken in. */
produce(deptstore_on_arrival,
    [PASS: incoming_cargo_waiting("PASS"); GOOD: incoming_cargo_waiting("GOOD");],
    [PASS: incoming_cargo_waiting("PASS");],
    0)

/* Staff: a small steady trickle whether or not anyone is delivered. */
produce(deptstore_on_monthly, [], [PASS: 2;], 0)

item(FEAT_INDUSTRIES, deptstore, 4) {
    property {
        substitute: 0;
        life_type: IND_LIFE_TYPE_PROCESSING;
        layouts: [deptstore_main_layout];
        cargo_types: [accept_cargo("PASS"), accept_cargo("GOOD"), produce_cargo("PASS", 0)];
        min_cargo_distr: 1;
        spec_flags: 0;
        name: string(STR_DEPTSTORE);
        nearby_station_name: string(STR_DEPTSTORE);
        fund_cost_multiplier: 30;
        remove_cost_multiplier: 0;
        prob_map_gen: 0;
        prob_in_game: 0;
        map_colour: 0x8A;
    }
    graphics {
        produce_cargo_arrival: deptstore_on_arrival;
        produce_256_ticks: deptstore_on_monthly;
    }
}

