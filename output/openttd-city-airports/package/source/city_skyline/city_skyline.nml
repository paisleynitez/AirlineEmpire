grf {
    grfid: "HCA3";
    name: string(STR_GRF_NAME);
    desc: string(STR_GRF_DESC);
    version: 1;
    min_compatible_version: 1;
}

spriteset(sprite_tile_0_1, "gfx/airport_skyline.png") { [512, 8, 64, 72, -31, -40] }
spritelayout layout_tile_0_1 {
    ground { sprite: 2634; }
    building { sprite: sprite_tile_0_1; xoffset: 0; yoffset: 0; zoffset: 0; xextent: 16; yextent: 16; zextent: 40; }
}
item(FEAT_AIRPORTTILES, tile_0_1) {
    property { substitute: 32; }
    graphics { default: layout_tile_0_1; }
}

