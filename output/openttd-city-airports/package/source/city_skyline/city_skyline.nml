    2, 6: 15;
    3, 6: 15;
    4, 6: 15;
    5, 6: 15;
    6, 6: 18;
}

item(FEAT_AIRPORTS, city_skyline) {
    property {
        override: 4;
        name: string(STR_AIRPORT_NAME);
        layouts: [airport_layout];
        years_available: [1960, 65535];
        ttd_airport_type: AIRPORTTYPE_LARGE;
        catchment_area: 8;
        noise_level: 17;
        maintenance_cost: 42;
    }
    graphics { additional_text: string(STR_ADDITIONAL); }
}
