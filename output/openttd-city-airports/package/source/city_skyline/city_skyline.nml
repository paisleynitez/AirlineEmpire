tilelayout airport_layout {
    rotation: DIRECTION_NORTH;
    0, 0: 49;
    1, 0: 50;
    2, 0: 50;
    3, 0: 50;
    4, 0: 50;
    5, 0: 50;
    6, 0: 49;
    0, 1: tile_0_1;
    1, 1: 0;
    2, 1: 0;
    3, 1: 0;
    4, 1: 0;
    5, 1: 0;
    6, 1: 24;
    0, 2: tile_0_2;
    1, 2: 0;
    2, 2: 3;
    3, 2: tile_3_2;
    4, 2: 3;
    5, 2: 0;
    6, 2: 2;
    0, 3: 24;
    1, 3: 0;
    2, 3: 3;
    3, 3: tile_3_3;
    4, 3: 3;
    5, 3: 0;
